# RateMyReview configuration (copy to .env and adjust as needed).
# Every value can also be set directly as an environment variable
# with the RMR_ prefix, e.g. RMR_MODEL_BACKEND=ridge.

# auto | distilbert | ridge | heuristic
RMR_MODEL_BACKEND=auto

# auto | cpu | cuda | mps
RMR_DEVICE=auto
RMR_MAX_SEQUENCE_LENGTH=256
RMR_PREDICTION_BATCH_SIZE=32

# RMR_RIDGE_MODEL_PATH=models/ridge_model.pkl
# RMR_DISTILBERT_WEIGHTS_DIR=models/distilbert_weights
# RMR_DEBUG=false
# RMR_CORS_ORIGINS=["http://localhost:3000"]
