# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Environments
.env

# Data artifacts
data/processed/*
!data/processed/.gitkeep
# Large raw datasets are kept out of git (train from the local copy)
data/raw/*
!data/raw/sample_reviews.csv

# Training checkpoints are disposable; binary weights are stored via Git LFS
# (see .gitattributes). JSON/tokenizer files live in regular git.
models/distilbert_weights/*
!models/distilbert_weights/.gitkeep
!models/distilbert_weights/*.json
!models/distilbert_weights/*.safetensors
!models/distilbert_weights/*.bin

# OS
.DS_Store
Thumbs.db
